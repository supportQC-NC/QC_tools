NODE_ENV=development
PORT=5000
MONGO_URI=
MONGO_SECRET=
MONGO_USERNAME=
MONGO_PASSWORD= 
JWT_SECRET=
CLIENT_URL=http://localhost:3000

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
# Module « Envoi Commande Fournisseur »
# Le MODE TEST se pilote désormais dans l'interface (par société) — pas ici.
# Par défaut il est ACTIF (aucun email n'atteint les fournisseurs) tant qu'on ne
# le désactive pas explicitement dans l'écran du module.
# ENVOI_CDE_TEST_EMAILS ci-dessous n'est que la valeur PAR DÉFAUT des adresses de
# test (surchargée par société dans l'interface).
ENVOI_CDE_TEST_EMAILS=support@quincaillerie.nc,communication@quincaillerie.nc,krysto.contact@gmail.com

# Assistant IA (OpenAI). Cle obligatoire pour activer le module assistant_ia.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Recherche web de l assistant IA ET du module Veille. Cle Tavily : https://tavily.com
# (sans elle, les rapports de veille sont rediges sans sources d actualite verifiees)
TAVILY_API_KEY=
# Module Veille : modeles OpenAI (facultatif, defaut = OPENAI_MODEL puis gpt-4o)
OPENAI_VEILLE_MODEL=
OPENAI_VEILLE_MODEL_PRO=
